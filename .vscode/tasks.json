{
  "version": "2.0.0",
  "options": {
    "cwd": "${workspaceFolder}",
    "env": {
      "JAVA_HOME": "D:\\Java\\jdk-20",
      "ANDROID_HOME": "D:\\Users\\lenovo\\AppData\\Local\\Android\\Sdk",
      "ANDROID_SDK_ROOT": "D:\\Users\\lenovo\\AppData\\Local\\Android\\Sdk"
    }
  },
  "tasks": [
    {
      "label": "Android: Build debug APK",
      "type": "shell",
      "command": ".\\gradlew.bat",
      "args": ["assembleDebug"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gradle"]
    },
    {
      "label": "Android: Install debug APK",
      "type": "shell",
      "command": ".\\gradlew.bat",
      "args": ["installDebug"],
      "dependsOn": "Android: Build debug APK",
      "problemMatcher": ["$gradle"]
    },
    {
      "label": "Android: Run unit tests",
      "type": "shell",
      "command": ".\\gradlew.bat",
      "args": ["testDebugUnitTest"],
      "group": "test",
      "problemMatcher": ["$gradle"]
    },
    {
      "label": "Android: Clean",
      "type": "shell",
      "command": ".\\gradlew.bat",
      "args": ["clean"],
      "problemMatcher": ["$gradle"]
    }
  ]
}
